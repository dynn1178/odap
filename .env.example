# ─────────────────────────────────────────────────────────────
# 오답노크 환경변수
# 이 파일을 .env.local 로 복사한 뒤 값을 채우세요. (.env.local 은 커밋되지 않습니다)
# Vercel 에 배포할 때는 Settings > Environment Variables 에 같은 값을 넣으세요.
# ─────────────────────────────────────────────────────────────

# 1) Google Cloud > 서비스 계정 > 키(JSON) 안의 client_email
GOOGLE_SERVICE_ACCOUNT_EMAIL=odapknock@내프로젝트.iam.gserviceaccount.com

# 2) 같은 JSON 안의 private_key
#    줄바꿈이 \n 문자로 들어가므로 반드시 큰따옴표로 감싸세요.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# 3) 스프레드시트 URL 의 /d/ 와 /edit 사이 값
#    https://docs.google.com/spreadsheets/d/[여기]/edit
GOOGLE_SHEET_ID=1AbCdEf...XyZ

# 4) 세션 쿠키 서명용 랜덤 문자열 (32자 이상)
SESSION_SECRET=여기에_32자_이상_랜덤_문자열

# 5) PIN 해시용 랜덤 문자열 (32자 이상). 한 번 정하면 바꾸지 마세요 — 바꾸면 기존 PIN 이 모두 무효가 됩니다.
PIN_SALT_SECRET=여기에_32자_이상_랜덤_문자열

# 6) (선택) 캐시 강제 무효화 엔드포인트 /api/cache/purge 호출용 토큰
CACHE_PURGE_TOKEN=아무_랜덤_문자열

# ※ 잊지 마세요: 스프레드시트 우측 상단 [공유] 에서 위 GOOGLE_SERVICE_ACCOUNT_EMAIL 주소를
#   "편집자(Editor)" 로 추가해야 합니다. 이걸 빼먹으면 permission 오류가 납니다.
